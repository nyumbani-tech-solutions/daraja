{
	"name": "nyumbani/daraja",
	"type": "library",
	"description": "A small Laravel client for Safaricom's Daraja API: STK push, C2B and Pull transactions, with the payloads, events and middleware to receive them.",
	"homepage": "https://nyumbanitech.co.ke/",
	"keywords": [
		"laravel",
		"mpesa",
		"daraja",
		"safaricom"
	],
	"license": "MIT",
	"authors": [
		{
			"name": "Alvin Kaburu",
			"email": "geekaburu@nyumbanitech.co.ke"
		}
	],
	"require": {
		"php": "^8.3",
		"illuminate/support": "^12.0||^13.0",
		"illuminate/http": "^12.0||^13.0",
		"illuminate/routing": "^12.0||^13.0",
		"illuminate/events": "^12.0||^13.0",
		"illuminate/cache": "^12.0||^13.0"
	},
	"autoload": {
		"psr-4": {
			"Nyumbani\\Daraja\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Nyumbani\\Daraja\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Nyumbani\\Daraja\\DarajaServiceProvider"
			]
		}
	},
	"require-dev": {
		"laravel/pint": "^1.27",
		"orchestra/testbench": "^10.0||^11.0",
		"pestphp/pest": "^4.0||^5.0"
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
